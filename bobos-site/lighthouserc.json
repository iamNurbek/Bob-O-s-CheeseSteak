{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3200",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/menu",
        "http://localhost:3200/about",
        "http://localhost:3200/cart"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/cart).*$",
          "assertions": { "categories:seo": ["error", { "minScore": 0.9 }] }
        }
      ]
    }
  }
}
